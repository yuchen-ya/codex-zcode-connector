{
  "name": "codex-zcode-connector",
  "version": "0.5.1",
  "description": "Delegate tasks from Codex to local ZCode with resumable questions, approvals and model selection.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "codex-zcode": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "lib/config-file.js",
    "lib/config.js",
    "lib/control-lock.js",
    "lib/install.js",
    "lib/interactions.js",
    "lib/model-options.js",
    "lib/protocol.js",
    "lib/runs.js",
    "lib/status.js",
    "lib/summaries.js",
    "lib/tasks.js",
    "lib/tools.js",
    "lib/zcode.js",
    "mcp/server.mjs",
    "scripts/install.mjs",
    "scripts/release.mjs",
    "scripts/smoke.mjs",
    "scripts/start-zcode.mjs",
    "scripts/verify-models.mjs",
    "skills/codex-zcode-connector/scripts/zcode.mjs",
    "skills/codex-zcode-connector/SKILL.md",
    "test/connector.test.mjs",
    "test/integration.test.mjs",
    "test/privacy.test.mjs"
  ],
  "scripts": {
    "start": "node cli.mjs",
    "cli": "node cli.mjs",
    "mcp": "node mcp/server.mjs",
    "setup": "node scripts/install.mjs",
    "remove": "node cli.mjs uninstall",
    "zcode": "node scripts/start-zcode.mjs",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "release": "node scripts/release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuchen-ya/codex-zcode-connector.git"
  }
}
